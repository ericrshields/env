# SSH config for work + grafana project (not cloud)
# Loaded conditionally via layered configuration system
# Using direct SSH instead of SSM Session Manager for simplicity and stability

Host dev-cloud
    HostName ec2-52-25-59-233.us-west-2.compute.amazonaws.com
    User ubuntu
    IdentityFile ~/.ssh/eshields-aws-us-west-2.pem
    ServerAliveInterval 10
    ServerAliveCountMax 3
    StrictHostKeyChecking accept-new
    IPQoS lowdelay throughput
    LocalForward 3000 localhost:3000
    LocalForward 3333 localhost:3333
    ExitOnForwardFailure yes
    LogLevel ERROR
